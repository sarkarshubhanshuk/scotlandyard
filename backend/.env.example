# Copy this file to `backend/.env` and fill in a real key. `.env` is gitignored.
#
# The 5 detective agents are served by OpenRouter (an OpenAI-API-compatible aggregator).
# Without this key the HTTP API still starts and Mr. X can still move, but the detective
# propose/debate/vote loop fails on its first LLM call.
#
# Get a key at https://openrouter.ai/keys - the model this project uses
# (see backend/scotland_yard/mcp_client.py:OPENROUTER_MODEL) is inexpensive, but note
# that one full round costs roughly 15 calls.
OPENROUTER_API_KEY=
